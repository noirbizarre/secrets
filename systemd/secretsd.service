# secretsd — the Secrets user-session daemon.
#
# Install as a user unit:
#   mkdir -p ~/.config/systemd/user
#   cp systemd/secretsd.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now secretsd.service
#
# `secretsd` requests its well-known name (org.secrets.Daemon) itself, so
# this unit does not need — and must not have — D-Bus activation (Type=dbus)
# racing it: the daemon calls RequestName once its own state is ready to
# serve, rather than the bus starting it on first use of a name it has not
# claimed yet.

[Unit]
Description=Secrets daemon — local secret broker and secret manager
Documentation=https://noirbizarre.github.io/secrets/
# The session bus must exist before secretsd can register on it.
After=dbus.socket
Requires=dbus.socket

[Service]
Type=simple
ExecStart=%h/.cargo/bin/secretsd
# Secret material lives in process memory; a crash should not silently
# leave the daemon down and every client failing closed without a signal a
# human or a supervisor would notice.
Restart=on-failure
RestartSec=1

# --- Sandboxing -------------------------------------------------------------
#
# Conservative, not exhaustive: the daemon needs the session bus, its own
# XDG data/runtime directories, and network access only for future backends
# (Vaultwarden, ...) that do not exist in this MVP — tightened further once
# those land.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/secrets %t/secrets
PrivateTmp=true

[Install]
WantedBy=default.target
